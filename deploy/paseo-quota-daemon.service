# Template only. Existing Paseo supervisor must be cleanly stopped before taking over its home.
[Unit]
Description=Paseo 0.11.2 with quota execution gate
After=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/workspace/paseo-quota-guard
ExecStart=/usr/local/bin/node %h/workspace/paseo-quota-guard/.local/release/server/dist/scripts/supervisor-entrypoint.js
Environment=PASEO_HOME=%h/.paseo
Environment=PASEO_QUOTA_GUARD_HOME=%h/.local/state/paseo-quota-guard
Environment=PASEO_QUOTA_GUARD_MODE=observe
Restart=on-failure
RestartSec=5
UMask=0077

[Install]
WantedBy=default.target
